{
  "name": "hustlingo",
  "version": "1.0.0-h1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_NO_TELEMETRY=1 expo start",
    "start:clear": "EXPO_NO_TELEMETRY=1 expo start --clear",
    "web": "EXPO_NO_TELEMETRY=1 expo start --web",
    "web:clear": "EXPO_NO_TELEMETRY=1 expo start --web --clear",
    "android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:preview:android": "eas build --platform android --profile preview",
    "build:production:android": "eas build --platform android --profile production",
    "build:production:ios": "eas build --platform ios --profile production",
    "build:production": "eas build --platform all --profile production",
    "validate": "node scripts/validate-project.mjs",
    "check": "npm run validate && npm run typecheck"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~54.0.36",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-speech": "~14.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.9",
    "typescript": "~5.9.2"
  }
}
