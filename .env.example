# Supabase client values; safe to expose only with RLS enabled.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Optional legacy anon key for older projects.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Backend-only seed credentials belong in ignored .env or .env.backend.local.
# Never commit a real secret key or add an EXPO_PUBLIC_ prefix to it.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
