# Supabase Project Settings -> API / Connect
# These are PUBLIC client values and are safe to bundle in Expo when RLS is enabled.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Optional legacy key name. Only use this if your Supabase project still shows an anon key.
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# AI provider secrets belong in Supabase Edge Function secrets, not this Expo app.
# Example server-side secrets:
# OPENAI_API_KEY=...
# AI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
